# ── dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── build output ─────────────────────────────────────────────────────────────
dist/

# ── test artifacts ───────────────────────────────────────────────────────────
test-results/
playwright-report/
e2e/screens/
e2e/.cache/

# ── optimized media is COMMITTED — do not re-ignore it ───────────────────────
# public/videos/ and public/projects/ (plus src/*.manifest.json and
# public/social/og-card.jpg) are generated by `npm run assets` from the raw
# sources under assets/, and the GENERATED OUTPUT IS COMMITTED. The deploy
# build is `vite build` only — the ffmpeg/sharp passes were eating Netlify's
# free build minutes, so they run LOCALLY, never in the deploy. The prebuild
# hook (scripts/check-assets.mjs) only verifies the committed output matches
# the config and fails the build if it doesn't.
#
# THE WORKFLOW (also in the README): if anything under assets/ changes, run
# `npm run assets` locally and commit the regenerated public/ output alongside
# it. Never put the optimizers back into the prebuild hook, and never re-add
# public/videos/ or public/projects/ to this file.

# ── heavy raw originals (not needed for the build; ~280 MB single file) ───────
assets/catalogs/pdf-originals/

# ── local tooling / OS ───────────────────────────────────────────────────────
.claude/
.DS_Store
*.log
npm-debug.log*
